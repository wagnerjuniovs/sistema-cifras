rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasOnlyFolderFields() {
      return request.resource.data.keys().hasOnly([
        'name',
        'parentId',
        'createdAt',
        'updatedAt'
      ]);
    }

    function validFolder() {
      return hasOnlyFolderFields()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && (
          request.resource.data.parentId == null
          || request.resource.data.parentId is string
        );
    }

    function hasOnlySongFields() {
      return request.resource.data.keys().hasOnly([
        'title',
        'artist',
        'content',
        'folderId',
        'createdAt',
        'updatedAt'
      ]);
    }

    function validSong() {
      return hasOnlySongFields()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 180
        && request.resource.data.artist is string
        && request.resource.data.artist.size() <= 180
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 400000
        && (
          request.resource.data.folderId == null
          || request.resource.data.folderId is string
        );
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /folders/{folderId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validFolder();
        allow delete: if isOwner(userId);
      }

      match /songs/{songId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validSong();
        allow delete: if isOwner(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
